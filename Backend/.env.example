# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=

# Used to sign/verify JWT auth tokens. Use a long random string in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Seed Admin Credentials (used by seed/adminSeed.js) ──────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MSG91 (https://msg91.com)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# Firebase (chat)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Razorpay (Route) ─────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys for KEY_ID/KEY_SECRET (test mode first).
# Dashboard → Settings → Webhooks for WEBHOOK_SECRET, after registering the
# webhook URL (Phase 4). Key Secret and Webhook Secret are different secrets —
# never reuse one for the other. Neither ever goes to a client app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 5, task 30: hours a Route transfer may sit on_hold after
# consultation completion before jobs/transferHoldMonitorJob.js flags it
# to admins. Optional — defaults to 6 if unset.
TRANSFER_HOLD_SLA_HOURS=6

# ─── Payout KYC field encryption (Phase 3) ────────────────────────────────────
# AES-256-GCM key used to encrypt doctor PAN/bank-account/UPI fields at rest
# (models/Doctor.js `payoutKyc`, utils/fieldEncryption.js). Must be a 64-char
# hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key requires re-encrypting existing payoutKyc rows — there is
# no key-versioning support yet.
PAYOUT_KYC_ENCRYPTION_KEY=
